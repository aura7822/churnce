{
  "manifest_version": 3,
  "name": "Churnce Observer",
  "description": "Consent-based friction signals from websites you are authorised to monitor. No keystrokes, no form values.",
  "version": "1.0.0",
  "minimum_chrome_version": "120",
  "permissions": ["storage", "scripting", "alarms"],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": { "default_title": "Churnce Observer", "default_popup": "popup.html" },
  "options_page": "settings.html"
}
